# Proyecto Supabase NUEVO para este CRM (no el inbound de reclu.cl).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Login del panel (una sola clave, ultra liviano — no multi-tenant).
CRM_APP_PASSWORD=cambia-esto

# Firma de la cookie de sesión. Cualquier string largo.
CRM_SESSION_SECRET=cambia-esto-tambien

# Bot outbound. Header: Authorization: Bearer <key>  o  x-crm-bot-key: <key>
CRM_BOT_KEY=sk_live_cambia-esto

# Opcional. Default 50.
CRM_DAILY_NEW_CAP=50
